#!/usr/bin/env bash
# Close the dev window before running scripts/dev-stop.
set -euo pipefail
[[ $# == 0 ]] || { echo 'usage: scripts/dev' >&2; exit 2; }
repo=$(cd "$(dirname "$0")/.." && pwd)
root=${TMPDIR:-/tmp}/canopy-dev
[[ $root == /* ]] || { echo 'TMPDIR must be absolute' >&2; exit 1; }
export HERDR_APP_HOME=$root/home HC_SESSION=canopy-dev HC_SOCKET=$root/c.sock
export XDG_STATE_HOME=$root/state XDG_CONFIG_HOME=$root/config
export HERDR_APP_NO_SOUND=1
unset HC_TERMINAL_ID HC_TERMINAL_SOCKET
[[ ${#HC_SOCKET} -le 80 ]] || { echo 'TMPDIR socket path too long; use TMPDIR=/tmp' >&2; exit 1; }
[[ -x $repo/target/debug/canopy ]] || { echo 'debug app missing; build it separately' >&2; exit 1; }
hc=$(command -v hc) || { echo 'hc missing from PATH' >&2; exit 1; }
[[ $hc == /* && -x $hc ]] || { echo 'hc must be an executable absolute path' >&2; exit 1; }
umask 077
mkdir -p "$HERDR_APP_HOME" "$XDG_STATE_HOME" "$XDG_CONFIG_HOME"
# A core this script reserved is still answering (the window was closed, not dev-stop):
# attach to it, so the saved layout and running terminals come back.
# shortcut: an open dev window is not detected, so a second run starts a second app on the same home; close it first.
if [[ -f $root/owned/hc && -S $HC_SOCKET ]] && "$(<"$root/owned/hc")" ls >/dev/null 2>&1; then
    echo 'reusing the running scratch core' >&2
    exec "$repo/target/debug/canopy"
fi
mkdir "$root/owned" || { echo 'scratch core reserved; close its window and run scripts/dev-stop' >&2; exit 1; }
if [[ -e $HC_SOCKET || -S $HC_SOCKET ]]; then
    rmdir "$root/owned"
    echo 'scratch socket already exists; refusing to attach' >&2
    exit 1
fi
printf '%s\n' "$hc" >"$root/owned/hc"
# Keep the reservation even on failure: dev-stop can stop a partially started core.
"$hc" server start
[[ -S $HC_SOCKET ]] || { echo 'core did not create the scratch socket' >&2; exit 1; }
exec "$repo/target/debug/canopy"
